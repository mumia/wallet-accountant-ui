{
  "name": "wallet-accountant-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate": "tsr generate && node scripts/generate-api.ts && prettier --write src/api/schema.gen.ts --ignore-path ''",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "contract:check": "node scripts/contract.ts check",
    "contract:update": "node scripts/contract.ts update",
    "dev:mock": "vite --host 0.0.0.0 --mode mock",
    "build:mock": "vite build --mode mock",
    "preview:mock": "vite preview --host 0.0.0.0 --mode mock",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@hookform/resolvers": "7.0.8",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "big.js": "7.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "i18next": "27.2.2",
    "lucide-react": "1.77.0",
    "oidc-client-ts": "3.5.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-oidc-context": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.108.2",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/big.js": "7.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
