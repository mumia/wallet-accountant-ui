# The UI's server (../wallet-accountant/docs/architecture/ui-contract.md):
# plain HTTP on 8080, /healthz, the SPA fallback, and caching by path.
{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Hashed by Vite, so cached forever. A missing asset is a 404, never
	# index.html: an HTML page must not be cached as a script for a year.
	handle /assets/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Mounted by the chart; a 404 when it isn't.
	handle /config.json {
		header Cache-Control "no-cache"
		file_server
	}

	# Every other path is a file of the build or a deep link into the app.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
